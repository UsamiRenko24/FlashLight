<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <!-- 1. 顶部导航 -->
    <ImageView
        android:id="@+id/traceback"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:padding="4dp"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Screen Fill Light"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/traceback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/traceback" />

    <ImageView
        android:id="@+id/iv_settings"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:padding="4dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. 背景预览大卡片 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_rounded_corner"
        android:backgroundTint="@color/grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <!-- 3. 模式切换滑块 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mode_switcher"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_rounded_frame"
            android:backgroundTint="#80777777"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/view_mode_thumb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_frame"
                android:backgroundTint="#1A1A1A"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5" />

            <ImageView
                android:id="@+id/btn_mode_brightness"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_brightness_gold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                app:tint="#FFCE64" />

            <ImageView
                android:id="@+id/btn_mode_color"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_palette"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 4. 进度条式亮度滑块容器 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_options_container"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_corner"
            android:backgroundTint="#80777777"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_mode_switcher">

            <!-- 轨道背景 (初始深灰色) -->
            <View
                android:id="@+id/view_slider_track"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginHorizontal="16dp"
                android:background="#464646"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 已经过的进度条 (蓝绿色) -->
            <View
                android:id="@+id/view_brightness_progress"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:background="#2AE1F8"
                app:layout_constraintBottom_toBottomOf="@id/view_slider_track"
                app:layout_constraintEnd_toEndOf="@id/view_brightness_thumb"
                app:layout_constraintStart_toStartOf="@id/view_slider_track"
                app:layout_constraintTop_toTopOf="@id/view_slider_track" />

            <!-- 滑块圆点 (金色，限制在轨道内) -->
            <View
                android:id="@+id/view_brightness_thumb"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_rounded"
                android:backgroundTint="#FFCE64"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@id/view_slider_track"
                app:layout_constraintEnd_toEndOf="@id/view_slider_track"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 隐形的交互层 (保持原 ID 以兼容代码) -->
            <LinearLayout
                android:id="@+id/group_brightness_options"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">
                <View android:id="@+id/card_left" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <View android:id="@+id/card_middle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <View android:id="@+id/card_right" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/group_color_options"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">
                <View android:id="@+id/card_left1" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_white" />
                <View android:id="@+id/card_middle1" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_warm_white" />
                <View android:id="@+id/card_right1" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_cold_white" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 5. 底部描述区域 -->
        <LinearLayout
            android:id="@+id/layout_bottom_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_bulb"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tips"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tv_brightness_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Brightness"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_light_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_corner"
                android:backgroundTint="#333333"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:text="Cold White Light\nMedium Brightness"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>