<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#0E0E0E">


    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_dp_16"
        android:text="@string/title_fill_light"
        android:textColor="@color/white"
        android:textSize="@dimen/sw_dp_19"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_settings"
        android:layout_width="@dimen/sw_dp_24"
        android:layout_height="@dimen/sw_dp_24"
        android:layout_marginEnd="@dimen/sw_dp_24"
        android:src="@drawable/ic_equalizer"
        android:contentDescription="设置"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_title" />

    <!-- 电池信息卡片 -->
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="@dimen/sw_dp_0"
        android:layout_height="@dimen/sw_dp_87"
        android:layout_marginStart="@dimen/sw_dp_24"
        android:layout_marginEnd="@dimen/sw_dp_24"
        android:layout_marginTop="@dimen/sw_dp_24"
        android:background="@drawable/bg_grey"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/sw_dp_16"
        android:paddingEnd="@dimen/sw_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <LinearLayout
            android:layout_width="@dimen/sw_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_battery_icon"
                        android:layout_width="@dimen/sw_dp_28"
                        android:layout_height="@dimen/sw_dp_28"
                        android:src="@drawable/ic_battery_75"
                        android:layout_marginEnd="@dimen/sw_dp_6"/>

                    <TextView
                        android:id="@+id/tv_battery_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sw_dp_15"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_battery_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_not_charging"
                    android:textColor="#8E8E93"
                    android:textSize="@dimen/sw_dp_12"
                    android:layout_marginTop="@dimen/sw_dp_3"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <ImageView
                android:layout_width="@dimen/sw_dp_20"
                android:layout_height="@dimen/sw_dp_20"
                android:layout_gravity="center"
                android:src="@drawable/ic_stopwatch"
                android:layout_marginBottom="@dimen/sw_dp_9"
                app:tint="#8E8E93"/>
            <TextView
                android:id="@+id/tv_flashlight_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:15"
                android:textColor="@color/white"
                android:textSize="@dimen/sw_dp_14"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/flashlight"
        android:layout_width="@dimen/sw_dp_160"
        android:layout_height="@dimen/sw_dp_160"
        android:layout_marginTop="@dimen/sw_dp_32"
        android:background="@drawable/btn_flashlight_on"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:elevation="@dimen/sw_dp_0"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/card_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_btn_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_flashlight"
        android:textColor="#5B3E00"
        android:textSize="@dimen/sw_dp_13"
        android:elevation="@dimen/sw_dp_10"
        android:layout_marginBottom="@dimen/sw_dp_28"
        app:layout_constraintBottom_toBottomOf="@id/flashlight"
        app:layout_constraintStart_toStartOf="@id/flashlight"
        app:layout_constraintEnd_toEndOf="@id/flashlight" />

    <LinearLayout
        android:id="@+id/layout_screen_light"
        android:layout_width="@dimen/sw_dp_0"
        android:layout_height="@dimen/sw_dp_110"
        android:layout_marginTop="@dimen/sw_dp_32"
        android:layout_marginStart="@dimen/sw_dp_24"
        android:layout_marginEnd="@dimen/sw_dp_6"
        android:background="@drawable/bg_grey"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toStartOf="@+id/layout_blink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashlight">
        <ImageView
            android:layout_width="@dimen/sw_dp_24"
            android:layout_height="@dimen/sw_dp_24"
            android:src="@drawable/ic_phone"
            android:layout_marginBottom="@dimen/sw_dp_8"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_screen_light"
            android:textColor="@color/white"
            android:textSize="@dimen/sw_dp_14"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:text="@string/soft_fill_light"
            android:textSize="@dimen/sw_dp_11"/>
    </LinearLayout>

    <View
        android:layout_width="@dimen/sw_dp_40"
        android:layout_height="@dimen/sw_dp_40"
        android:alpha="0.4"
        android:background="@drawable/ic_ellipse_left"
        app:layout_constraintTop_toTopOf="@id/layout_screen_light"
        app:layout_constraintEnd_toEndOf="@id/layout_screen_light"/>

    <LinearLayout
        android:id="@+id/layout_blink"
        android:layout_width="@dimen/sw_dp_0"
        android:layout_height="@dimen/sw_dp_110"
        android:layout_marginStart="@dimen/sw_dp_6"
        android:layout_marginEnd="@dimen/sw_dp_24"
        android:background="@drawable/bg_grey"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_screen_light"
        app:layout_constraintTop_toTopOf="@+id/layout_screen_light">
        <ImageView
            android:layout_width="@dimen/sw_dp_24"
            android:layout_height="@dimen/sw_dp_24"
            android:src="@drawable/ic_lighting"
            android:layout_marginBottom="@dimen/sw_dp_8"/>
        <TextView
            android:id="@+id/tv_blink_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_blink"
            android:textColor="@color/white"
            android:textSize="@dimen/sw_dp_14"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:text="@string/signal_alert"
            android:textSize="@dimen/sw_dp_11"/>
    </LinearLayout>

    <View
        android:layout_width="@dimen/sw_dp_40"
        android:layout_height="@dimen/sw_dp_40"
        android:alpha="0.4"
        android:background="@drawable/ic_ellipse_right"
        app:layout_constraintTop_toTopOf="@id/layout_blink"
        app:layout_constraintEnd_toEndOf="@id/layout_blink"/>

    <TextView
        android:id="@+id/tv_quick_settings_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quick_settings"
        android:textColor="@color/white"
        android:textSize="@dimen/sw_dp_15"
        android:layout_marginBottom="@dimen/sw_dp_8"
        app:layout_constraintBottom_toTopOf="@id/constraintLayout"
        app:layout_constraintStart_toStartOf="@id/constraintLayout" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="@dimen/sw_dp_0"
        android:layout_height="@dimen/sw_dp_120"
        android:layout_marginStart="@dimen/sw_dp_24"
        android:layout_marginEnd="@dimen/sw_dp_24"
        android:layout_marginTop="@dimen/sw_dp_40"
        android:background="@drawable/bg_grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_blink">

        <LinearLayout
            android:id="@+id/left_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 拓宽区域：自动关闭时间 -->
            <LinearLayout
                android:id="@+id/layout_auto_off"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_dp_0"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/sw_dp_16"
                android:paddingEnd="@dimen/sw_dp_16"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="@dimen/sw_dp_0"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_auto_off"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sw_dp_14" />
                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5分钟"
                    android:textColor="#8E8E93"
                    android:textSize="@dimen/sw_dp_14" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_dp_1"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_dp_0"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/sw_dp_16"
                android:paddingEnd="@dimen/sw_dp_16">
                <TextView
                    android:layout_width="@dimen/sw_dp_0"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_vibration"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sw_dp_14" />
                <com.name.flashlight.SlidingButton
                    android:id="@+id/btn_switch"
                    android:layout_width="@dimen/sw_dp_45"
                    android:layout_height="@dimen/sw_dp_22" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sw_dp_1"
        android:background="#131313"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemBackground="@null"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>