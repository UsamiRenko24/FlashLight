<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FlashlightActivity"
    android:background="#0E0E0E">

    <!-- 顶部导航栏：同步 MainActivity 居中样式 -->
    <ImageView
        android:id="@+id/traceback"
        android:src="@drawable/traceback"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:contentDescription="返回"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/title_flashlight"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_settings"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_equalizer"
        android:contentDescription="设置"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <!-- 电池与时间卡片：同步 MainActivity 布局 -->
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="335dp"
        android:layout_height="87dp"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_grey"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <!-- 左侧电量组：完美居中 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_battery_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_battery_75"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tv_battery_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_battery_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="充电中"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧统计组 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_stopwatch"/>
            <TextView
                android:id="@+id/tv_flashlight_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:15"
                android:layout_marginTop="9dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/view_halo"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0"
        android:visibility="gone"
        android:background="@drawable/bg_flashlight_halo"
        app:layout_constraintTop_toTopOf="@id/btn_flashlight"
        app:layout_constraintBottom_toBottomOf="@id/btn_flashlight"
        app:layout_constraintStart_toStartOf="@id/btn_flashlight"
        app:layout_constraintEnd_toEndOf="@id/btn_flashlight" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_flashlight"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/btn_flashlight_off"
        android:stateListAnimator="@null"
        android:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/card_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_btn_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_off"
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:elevation="10dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_flashlight"
        app:layout_constraintStart_toStartOf="@id/btn_flashlight"
        app:layout_constraintEnd_toEndOf="@id/btn_flashlight" />

    <LinearLayout
        android:layout_width="343dp"
        android:layout_height="145dp"
        android:id="@+id/container"
        app:layout_constraintTop_toBottomOf="@+id/btn_flashlight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_grey">
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brightness_level"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginStart="11dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_flashlight" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/card_left"
                android:layout_width="98dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_rounded_selector"
                android:orientation="vertical"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="14dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brightness_card_low"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textSize="15dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_middle"
                android:layout_width="98dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_rounded_selector"
                android:orientation="vertical"
                app:layout_constraintHorizontal_chainStyle="packed"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brightness_card_medium"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textSize="15dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_right"
                android:layout_width="98dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_rounded_selector"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brightness_card_high"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textSize="15dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="343dp"
        android:layout_height="114dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_grey"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clock"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_total_time1"
                    android:layout_width="wrap_content"
                    android:layout_height="19dp"
                    android:text="5分钟"
                    android:textSize="14sp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/white"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_auto_off"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="3dp"
                    android:textSize="10sp"
                    android:textColor="@color/grey"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/progress_flashlight"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="19dp"
                android:layout_marginStart="19dp"
                android:layout_marginEnd="19dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_bar" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <TextView
                    android:id="@+id/last_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:layout_marginStart="20dp"
                    android:textSize="14sp"
                    android:textColor="@color/grey"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/tv_total_time2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5分钟"
                    android:textSize="14sp"
                    android:layout_marginEnd="20dp"
                    android:textColor="@color/grey" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/temperature_container"
        android:layout_width="343dp"
        android:layout_height="84dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_grey"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/iv_temperature"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="20dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/temperature" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="50dp">
            <TextView
                android:id="@+id/tv_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/normal_temperature"
                android:textColor="@color/white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/allow_for_ventilation"
                android:textColor="@color/grey"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>