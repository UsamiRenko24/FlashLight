<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FlashLight" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nav_selected_bg</item>
        <item name="colorSecondaryVariant">@color/nav_selected_bg</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">#0E0E0E</item>
    </style>

    <!-- 工业级：自动关闭时间卡片样式 -->
    <style name="TimerCardStyle">
        <item name="android:layout_width">@dimen/sw_dp_0</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/sw_dp_4</item>
        <item name="android:background">@drawable/bg_rounded_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TimerTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/sw_dp_14</item>
    </style>
    <!-- SplashScreen API Theme -->
    <style name="Theme.FlashLight.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- 核心修改：将图标设为透明 -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.FlashLight</item>
    </style>
</resources>