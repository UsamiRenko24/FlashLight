<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/traceback"
        android:layout_width="@dimen/sw_dp_32"
        android:layout_height="@dimen/sw_dp_32"
        android:layout_marginStart="@dimen/sw_dp_16"
        android:contentDescription="返回"
        android:src="@drawable/traceback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_dp_10"
        android:text="@string/title_settings"
        android:textColor="@color/white"
        android:textSize="@dimen/sw_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sw_dp_0"
        android:layout_marginTop="@dimen/sw_dp_10"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sw_dp_16">

            <!-- 基础设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sw_dp_10"
                android:text="@string/basic_settings"
                android:textColor="@color/white"
                android:textSize="@dimen/sw_dp_12" />

            <LinearLayout
                android:id="@+id/container1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_dp_204"
                android:background="@drawable/bg_grey"
                android:orientation="vertical">

                <!-- 自动关闭时间 -->
                <LinearLayout
                    android:id="@+id/layout_auto_off"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_68"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_16"
                    android:paddingEnd="@dimen/sw_dp_16"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/sw_dp_34"
                        android:layout_height="@dimen/sw_dp_34"
                        android:layout_marginEnd="@dimen/sw_dp_12"
                        android:src="@drawable/ic_clock" />

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_auto_off"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sw_dp_12"
                        android:src="@drawable/arrow_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_1"
                    android:background="#131313" />

                <!-- 启动模式 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_68"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_16"
                    android:paddingEnd="@dimen/sw_dp_16">

                    <ImageView
                        android:layout_width="@dimen/sw_dp_34"
                        android:layout_height="@dimen/sw_dp_34"
                        android:layout_marginEnd="@dimen/sw_dp_12"
                        android:src="@drawable/ic_power_button" />

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_startup_mode"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />
                    </LinearLayout>

                    <!-- 使用 TextView 模拟 Spinner -->
                    <TextView
                        android:id="@+id/tv_startup_mode"
                        android:layout_width="@dimen/sw_dp_100"
                        android:layout_height="@dimen/sw_dp_32"
                        android:background="@drawable/bg_spinner_button"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sw_dp_12"
                        android:clickable="true"
                        android:focusable="true"
                        tools:text="上次用" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_1"
                    android:background="#33FFFFFF" />

                <!-- 默认亮度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_68"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_16"
                    android:paddingEnd="@dimen/sw_dp_16">

                    <ImageView
                        android:layout_width="@dimen/sw_dp_34"
                        android:layout_height="@dimen/sw_dp_34"
                        android:layout_marginEnd="@dimen/sw_dp_12"
                        android:src="@drawable/ic_brightness" />

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_brightness"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />
                    </LinearLayout>

                    <!-- 使用 TextView 模拟 Spinner -->
                    <TextView
                        android:id="@+id/tv_brightness"
                        android:layout_width="@dimen/sw_dp_100"
                        android:layout_height="@dimen/sw_dp_32"
                        android:background="@drawable/bg_spinner_button"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sw_dp_12"
                        android:clickable="true"
                        android:focusable="true"
                        tools:text="中亮度" />
                </LinearLayout>
            </LinearLayout>

            <!-- 页面设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sw_dp_20"
                android:layout_marginBottom="@dimen/sw_dp_10"
                android:text="@string/page_settings"
                android:textColor="@color/white"
                android:textSize="@dimen/sw_dp_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grey"
                android:orientation="vertical"
                android:paddingTop="@dimen/sw_dp_10"
                android:paddingBottom="@dimen/sw_dp_10">

                <LinearLayout
                    android:id="@+id/card_container5"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_66"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_16"
                    android:paddingEnd="@dimen/sw_dp_12">

                    <ImageView
                        android:layout_width="@dimen/sw_dp_34"
                        android:layout_height="@dimen/sw_dp_34"
                        android:layout_marginEnd="@dimen/sw_dp_12"
                        android:src="@drawable/ic_language" />

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/language_settings"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />

                    </LinearLayout>

                    <!-- 使用 TextView 模拟 Spinner -->
                    <TextView
                        android:id="@+id/tv_language"
                        android:layout_width="@dimen/sw_dp_100"
                        android:layout_height="@dimen/sw_dp_32"
                        android:background="@drawable/bg_spinner_button"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sw_dp_12"
                        android:clickable="true"
                        android:focusable="true"
                        tools:text="简体中文" />
                </LinearLayout>


            </LinearLayout>

            <!-- 功能设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sw_dp_20"
                android:layout_marginBottom="@dimen/sw_dp_10"
                android:text="@string/function_setting"
                android:textColor="@color/white"
                android:textSize="@dimen/sw_dp_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_dp_198"
                android:background="@drawable/bg_grey"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/card_container7"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_66"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_20"
                    android:paddingEnd="@dimen/sw_dp_16">

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_vibration"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />

                    </LinearLayout>

                    <com.name.flashlight.SlidingButton
                        android:id="@+id/btn_vibration"
                        android:layout_width="@dimen/sw_dp_40"
                        android:layout_height="@dimen/sw_dp_20" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_1"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:id="@+id/card_container8"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_66"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_20"
                    android:paddingEnd="@dimen/sw_dp_16">

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_sound"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />

                    </LinearLayout>

                    <com.name.flashlight.SlidingButton
                        android:id="@+id/sliding_sound"
                        android:layout_width="@dimen/sw_dp_40"
                        android:layout_height="@dimen/sw_dp_20" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_1"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:id="@+id/card_container9"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_66"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_20"
                    android:paddingEnd="@dimen/sw_dp_16">

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eye_protection_mode"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />

                    </LinearLayout>

                    <com.name.flashlight.SlidingButton
                        android:id="@+id/sliding_auto_brightness"
                        android:layout_width="@dimen/sw_dp_40"
                        android:layout_height="@dimen/sw_dp_20" />
                </LinearLayout>
            </LinearLayout>

            <!-- 数据管理 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sw_dp_20"
                android:layout_marginBottom="@dimen/sw_dp_10"
                android:text="@string/data_management"
                android:textColor="@color/white"
                android:textSize="@dimen/sw_dp_12" />

            <LinearLayout
                android:id="@+id/container_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grey"
                android:orientation="vertical"
                android:paddingTop="@dimen/sw_dp_10"
                android:paddingBottom="@dimen/sw_dp_10">

                <LinearLayout
                    android:id="@+id/card_container10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_70"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_16"
                    android:paddingEnd="@dimen/sw_dp_16"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/sw_dp_34"
                        android:layout_height="@dimen/sw_dp_34"
                        android:layout_marginEnd="@dimen/sw_dp_12"
                        android:src="@drawable/ic_stats_differ" />

                    <LinearLayout
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/usage_stats"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sw_dp_14" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/check_usage_situation"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/sw_dp_12" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- 关于应用 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sw_dp_20"
                android:layout_marginBottom="@dimen/sw_dp_10"
                android:text="@string/about_application"
                android:textColor="@color/white"
                android:textSize="@dimen/sw_dp_12" />

            <LinearLayout
                android:id="@+id/container_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grey"
                android:orientation="vertical"
                android:paddingTop="@dimen/sw_dp_10"
                android:paddingBottom="@dimen/sw_dp_10">

                <LinearLayout
                    android:id="@+id/card_container13"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_dp_70"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/sw_dp_16"
                    android:paddingEnd="@dimen/sw_dp_16">

                    <TextView
                        android:layout_width="@dimen/sw_dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/version_info"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sw_dp_14" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.0"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/sw_dp_14" />
                </LinearLayout>
            </LinearLayout>

            <!-- 底部间距，确保内容不被 BottomNav 挡住 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_dp_20" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sw_dp_1"
        android:background="#131313"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="@dimen/sw_dp_0"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:itemBackground="@null"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>