<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 圆角设置：只有底部两个角有圆角 -->
    <corners
        android:topLeftRadius="@dimen/sw_dp_0"
        android:topRightRadius="@dimen/sw_dp_0"
        android:bottomLeftRadius="@dimen/sw_dp_8"
        android:bottomRightRadius="@dimen/sw_dp_8" />

    <!-- 边框设置 -->
    <stroke
        android:width="@dimen/sw_dp_2"
        android:color="#374151" />

    <!-- 填充颜色 -->
    <solid android:color="#191D23" />

    <!-- 内边距 -->
    <padding
        android:left="@dimen/sw_dp_10"
        android:top="@dimen/sw_dp_10"
        android:right="@dimen/sw_dp_10"
        android:bottom="@dimen/sw_dp_10" />

</shape>