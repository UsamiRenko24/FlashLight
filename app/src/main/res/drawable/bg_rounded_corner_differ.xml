<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">  <!-- 矩形形状 -->

    <!-- 圆角设置 -->
    <corners
        android:radius="@dimen/sw_dp_8"/>


    <!-- 边框设置 -->
    <stroke
        android:width="@dimen/sw_dp_2"
        android:color="#374151" />

    <!-- 填充颜色 -->
    <solid android:color="#191D23"/>

    <!-- 内边距（可选） -->
    <padding
        android:left="@dimen/sw_dp_10"
        android:top="@dimen/sw_dp_10"
        android:right="@dimen/sw_dp_10"
        android:bottom="@dimen/sw_dp_10"/>

</shape>