<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态：使用你指定的亮青色 (#2AE1F8) 作为高亮描边 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0B0B0B" /> <!-- 保持深色背景，突出描边 -->
            <stroke android:width="@dimen/sw_dp_1" android:color="#2AE1F8" />
            <corners android:radius="@dimen/sw_dp_12" />
        </shape>
    </item>

    <!-- 默认状态：暗色背景，无描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0B0B" />
            <corners android:radius="@dimen/sw_dp_12" />
        </shape>
    </item>
</selector>