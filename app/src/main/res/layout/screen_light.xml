<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">
    <ImageView
        android:id="@+id/traceback"
        android:src="@drawable/traceback"
        android:layout_width="@dimen/sw_dp_32"
        android:layout_height="@dimen/sw_dp_32"
        android:layout_marginStart="@dimen/sw_dp_16"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="返回"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"/>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Screen Fill Light"
        android:textColor="@color/white"
        android:textSize="@dimen/sw_dp_18"
        android:layout_marginTop="@dimen/sw_dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- 2. 背景预览大卡片 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sw_dp_0"
        android:layout_margin="@dimen/sw_dp_16"
        android:layout_marginTop="@dimen/sw_dp_20"
        android:background="@drawable/bg_rounded_corner"
        android:backgroundTint="@color/grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <!-- 3. 模式切换滑块 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mode_switcher"
            android:layout_width="@dimen/sw_dp_160"
            android:layout_height="@dimen/sw_dp_50"
            android:layout_marginTop="@dimen/sw_dp_32"
            android:background="@drawable/bg_rounded_frame"
            android:backgroundTint="#80777777"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/view_mode_thumb"
                android:layout_width="@dimen/sw_dp_0"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_frame"
                android:backgroundTint="#1A1A1A"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5" />

            <ImageView
                android:id="@+id/btn_mode_brightness"
                android:layout_width="@dimen/sw_dp_0"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_brightness_gold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                app:tint="#FFCE64" />

            <ImageView
                android:id="@+id/btn_mode_color"
                android:layout_width="@dimen/sw_dp_0"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_palette"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_options_container"
            android:layout_width="@dimen/sw_dp_200"
            android:layout_height="@dimen/sw_dp_56"
            android:layout_marginTop="@dimen/sw_dp_16"
            android:background="@drawable/bg_rounded_corner"
            android:backgroundTint="#80777777"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_mode_switcher">

            <!-- 亮度 -->
            <LinearLayout
                android:id="@+id/group_brightness_options"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/card_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/iv_brightness_low"
                        android:layout_width="@dimen/sw_dp_16"
                        android:layout_height="@dimen/sw_dp_16"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_brightness_gold"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/card_middle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_brightness_medium"
                        android:layout_width="@dimen/sw_dp_24"
                        android:layout_height="@dimen/sw_dp_24"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_brightness_gold"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/card_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_brightness_high"
                        android:layout_width="@dimen/sw_dp_32"
                        android:layout_height="@dimen/sw_dp_32"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_brightness_gold"
                        app:tint="#FFFFFF" />

                </FrameLayout>

            </LinearLayout>

            <!-- 色温 -->
            <LinearLayout
                android:id="@+id/group_color_options"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/card_left1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/iv_color_white"
                        android:layout_width="@dimen/sw_dp_28"
                        android:layout_height="@dimen/sw_dp_28"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_white"/>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/card_middle1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/iv_color_warm"
                        android:layout_width="@dimen/sw_dp_28"
                        android:layout_height="@dimen/sw_dp_28"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_warm_white"/>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/card_right1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/iv_color_cold"
                        android:layout_width="@dimen/sw_dp_28"
                        android:layout_height="@dimen/sw_dp_28"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_cold_white"/>
                </FrameLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 5. 底部描述区域 -->
        <LinearLayout
            android:id="@+id/layout_bottom_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sw_dp_48"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_bulb"
                android:layout_width="@dimen/sw_dp_24"
                android:layout_height="@dimen/sw_dp_24"
                android:src="@drawable/ic_tips"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tv_brightness_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sw_dp_4"
                android:text="Brightness"
                android:textColor="@color/black"
                android:textSize="@dimen/sw_dp_14" />

            <TextView
                android:id="@+id/tv_light_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sw_dp_16"
                android:background="@drawable/bg_rounded_corner"
                android:backgroundTint="#333333"
                android:gravity="center"
                android:paddingHorizontal="@dimen/sw_dp_24"
                android:paddingVertical="@dimen/sw_dp_12"
                android:text="Cold White Light\nMedium Brightness"
                android:textColor="@color/white"
                android:textSize="@dimen/sw_dp_16" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>